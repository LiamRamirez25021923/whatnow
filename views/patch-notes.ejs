<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WhatNow — Patch Notes</title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico?v=3">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon_io/favicon-32x32.png?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon_io/favicon-16x16.png?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png?v=3">
  <link rel="manifest" href="/images/favicon_io/site.webmanifest?v=3">
    <link rel="stylesheet" href="/styles.css">
  </head>

  <body>
    <main class="page">
      <section class="card patch-notes-card">
        <div class="patch-notes-header">
          <div>
            <h1>WhatNow Patch Notes</h1>
            <% if (updatedAt) { %>
              <p class="muted-text">
                Last updated: <%= new Date(updatedAt).toLocaleString() %>
              </p>
            <% } %>
          </div>

          <div class="dashboard-actions">
            <% if (user) { %>
              <a class="btn secondary" href="/dashboard">Back to Dashboard</a>
            <% } else { %>
              <a class="btn secondary" href="/">Back to Login</a>
            <% } %>

            <% if (isAdmin) { %>
              <a class="btn" href="/patch-notes/edit">Edit Patch Notes</a>
            <% } %>
          </div>
        </div>

        <article class="markdown-content">
          <%- contentHtml %>
        </article>
      </section>
    </main>
    <script src="/theme.js"></script>
    <script src="/ui-sounds.js"></script>
</body>
</html>
