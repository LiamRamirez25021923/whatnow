<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>WhatNow — Create account</title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico?v=3">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon_io/favicon-32x32.png?v=3">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon_io/favicon-16x16.png?v=3">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon_io/apple-touch-icon.png?v=3">
  <link rel="manifest" href="/images/favicon_io/site.webmanifest?v=3">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="page">
      <header class="brand">WhatNow<span class="q">?</span></header>

      <section class="card login-card">
        <h2 class="card-title">Create account</h2>
        <% if (error) { %>
          <div class="error"><%= error %></div>
        <% } %>
        <form action="/register" method="post" class="login-form">
          <input name="username" placeholder="Username" value="<%= username %>" class="text-input" />
          <input name="password" type="password" placeholder="Password" class="text-input" />
          <input name="confirm" type="password" placeholder="Confirm password" class="text-input" />
          <button class="btn" type="submit">Create account</button>
        </form>
        <p style="margin-top:12px">Already have an account? <a href="/">Log in</a></p>
      </section>
    </main>
    <script src="/theme.js"></script>
    <script src="/ui-sounds.js"></script>
</body>
</html>
